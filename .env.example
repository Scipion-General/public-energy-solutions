# ---------------------------------------------------------------------------
# Contact form email (server-side only, never exposed to the browser).
# Choose ONE provider. Test your settings with:  npm run mail:test
# ---------------------------------------------------------------------------

# Optional: force the provider ("resend" or "smtp"). If unset: resend when
# RESEND_API_KEY is set, otherwise smtp.
# MAIL_PROVIDER=

# Option A (recommended on Vercel/serverless) - Resend HTTP API, no SMTP login.
# Create a key at https://resend.com and verify your sending domain there.
# RESEND_API_KEY=

# Option B - SMTP (your mail provider or a sending service such as Brevo/Mailgun).
# Gmail: use an *app password*. Outlook.com/Hotmail: password SMTP login is no longer accepted.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465). Defaults to true only when SMTP_PORT=465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Sender address - must be allowed by your provider (e.g. an address on a verified domain).
CONTACT_FROM_EMAIL=website@public-energy-solutions.com
# Recipient of contact-form messages (defaults to contact@public-energy-solutions.com).
CONTACT_TO_EMAIL=contact@public-energy-solutions.com

# ---------------------------------------------------------------------------
# Data files (optional overrides, paths relative to the project root)
# ---------------------------------------------------------------------------
# PRICE_DATA_FILE=data/gas-prices.csv
# TTF_DATA_FILE=data/ttf.csv
