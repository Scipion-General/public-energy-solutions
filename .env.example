# SMTP server used to send contact-form messages (server-side only, never exposed to the browser).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465). Defaults to true only when SMTP_PORT=465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Sender address (must be allowed by your SMTP provider, e.g. a verified domain address).
CONTACT_FROM_EMAIL=website@public-energy-solutions.com
# Recipient of contact-form messages (defaults to contact@public-energy-solutions.com).
CONTACT_TO_EMAIL=contact@public-energy-solutions.com

# Optional: path to the price CSV, relative to the project root.
# PRICE_DATA_FILE=data/gas-prices.csv
